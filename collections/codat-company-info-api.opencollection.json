{
  "opencollection": "1.0.0",
  "info": {
    "name": "Bank Feeds Account mapping Company info API",
    "version": "3.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Company info",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get company accounting profile",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.codat.io/companies/:companyId/data/info",
            "params": [
              {
                "name": "companyId",
                "value": "",
                "type": "path",
                "description": "Unique identifier for a company."
              }
            ]
          },
          "docs": "Gets the latest basic info for a company."
        },
        {
          "info": {
            "name": "Get company commerce profile",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.codat.io/companies/:companyId/connections/:connectionId/data/commerce-info",
            "params": [
              {
                "name": "companyId",
                "value": "",
                "type": "path",
                "description": "Unique identifier for a company."
              },
              {
                "name": "connectionId",
                "value": "",
                "type": "path",
                "description": "Unique identifier for a connection."
              }
            ]
          },
          "docs": "Retrieve information about the company, as seen in the commerce\nplatform.\n\nThis may include information like addresses, tax registration details and\nsocial media or website information.\""
        }
      ]
    }
  ],
  "bundled": true
}