                "name": "Business Current Account"
              },
              "id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
              "date": "2023-01-25",
              "description": "Payment to supplier",
              "amount": 100,
              "currency": "USD",
              "transactionCategory": {
                "confidence": 92.7,
                "levels": [
                  "Asset",
